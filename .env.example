# Local dev: copy to .env (gitignored). Vite dev proxy uses /api when unset.
# Production (Cloudflare Pages): set in Build environment variables.

# Local — Vite proxy forwards /api to localhost:8080 (see vite.config.js)
# VITE_API_BASE_URL=/api

# Production — your Render backend URL
# VITE_API_BASE_URL=https://smartload-api-xxxx.onrender.com/api
